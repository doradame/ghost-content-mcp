{
  "name": "ghost-content-mcp",
  "version": "1.0.0",
  "description": "A read-only MCP server that turns any Ghost site into a semantic content-discovery source for AI assistants (hybrid BM25 + local embeddings search).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "ghost-content-mcp": "dist/index.js" },
  "repository": { "type": "git", "url": "git+https://github.com/doradame/ghost-content-mcp.git" },
  "keywords": ["mcp", "model-context-protocol", "ghost", "cms", "semantic-search", "embeddings", "rag"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "fetch-model": "node scripts/fetch-model.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@xenova/transformers": "^2.17.2",
    "express": "^4.21.2",
    "turndown": "^7.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
